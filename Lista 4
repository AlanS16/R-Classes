#Exercício 11
par(mfrow = c(4,5), mar = c(2,2,2,2))
print("Testes de Normalidade Shapiro-Wilk")
for(coluna in names(w)) {
       if(is.numeric(w[[coluna]]) & coluna != "grupos_idade") {
              qqnorm(w[[coluna]], main = coluna)
              qqline(w[[coluna]], col = "red")
              cat("\nVariável:", coluna, "\n") 
              print(shapiro.test(w[[coluna]]))}}

#Exercício 12
print("Test-t")
for(coluna in names(w)) { 
       if(is.numeric(w[[coluna]]) & coluna != "grupos_idade") {
