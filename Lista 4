# Removendo os objetos ativos

rm(list=ls())
w = read.table("https://codeberg.org/edsonzmartinez/CursoR/raw/branch/main/antropo.txt", header = TRUE, na.strings = "NA")

#Exercício 1
#Criando nova variável para peso em kgs
w$peso_kg = w$Weight * 0.45359237
w$peso_kg

#Exercício 2
#Criando nova varíavel para altura em centímetros
w$altura_cm = w$Height * 2.54
w$altura_cm

#Exercício 3 - Box Plot
#Dividir a tela em 4 linhas e 5 colunas
par(mfrow=c(4,5), mar=c(3,3,3,3)) 

#Loop para cada variável
for (coluna in names(w)) {boxplot(w[[coluna]], main = coluna, col = "red", pch = 19, staplewex = 0.3,whisklty = 1, boxwex = 0.6, axes = TRUE, xlab = "")
       mtext(side = 1,at = 0.5,line = 1,"Média")
       mtext(side = 1,at = 0.5,line = 2.2,"DP")
       mtext(side = 1,at = 1,line = 1,round(mean(w[[coluna]])))
       mtext(side = 1,at = 1,line = 2.2,round(sd(w[[coluna]])))}


#Exercício 4
plot(w$altura_cm, w$peso_kg, xlab = "Altura (cm)", ylab = "Peso (kg)",main = "Dispersão do Peso vs Altura",pch = 19, col = "Blue")

#Tendência dos dados de peso em relação à altura
mod = lm(peso_kg ~ altura_cm, data = w) 

#Padronização dos valores para outliers.
resid_pad = rstandard(mod) 
outlier_relacao = which(abs(resid_pad) > 2) 
points(w$altura_cm[outlier_relacao], w$peso_kg[outlier_relacao], col = "red", pch = 19, cex = 1.2)
legend("topleft", legend = c("Dados normais", "Outliers"), col = c("Blue", "red"), pch = 19)

#Exercício 5
#Divide em 3 colunas
par(mfrow = c(1,3), mar = c(8,4,4,2))

# Testes de Shapiro-Wilk
teste_idade = shapiro.test(w$Age)
teste_peso = shapiro.test(w$peso_kg)
teste_altura = shapiro.test(w$altura_cm)

# Idade
hist(w$Age,main = "Idade",xlab = "Anos",col = "green")

if(teste_idade$p.value > 0.05){
       resultado = "normal"} 
	else {resultado = "nao normal"}

mtext(paste("p =", format(teste_idade$p.value, scientific = TRUE)),side = 1,line = 5,cex = 0.7)

mtext(resultado,side = 1,line = 6,cex = 0.7)

# Peso
hist(w$peso_kg,main = "Peso",xlab = "kg",col = "red")

if(teste_peso$p.value > 0.05){
       resultado = "normal"} 
	else {resultado = "nao normal"}

mtext(paste("p =", format(teste_peso$p.value, scientific = TRUE)),side = 1,line = 5,cex = 0.7)

mtext(resultado,side = 1,line = 6,cex = 0.7)

# Estatura
hist(w$altura_cm,main = "Estatura",xlab = "cm",col = "blue")

if(teste_altura$p.value > 0.05){
       resultado = "normal"} 
	else {resultado = "nao normal"}

mtext(paste("p =", format(teste_altura$p.value, scientific = TRUE)),side = 1,line = 5,cex = 0.7)

mtext(resultado,side = 1,line = 6,cex = 0.7)

