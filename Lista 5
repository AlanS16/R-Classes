#Função que calcula LDL-c pela equação de Friedewald
CalculoLDL = function(CT, HDLc, TG, jejum=TRUE) {
    
    #Calcular VLDLc
    VLDLc = TG / 5

    #Calcular LDLc
    LDLc = CT - HDLc - VLDLc

        #Hipertrigliceridemia
        if(TG >= 400) {warning("TG Extrapola 400 mg/ml, Equação Imprecisa")}
                

        #Hiperlipidemia mista
        if(jejum == TRUE) {
            if(LDLc >= 160 && TG >= 150) {warning("Hiperlipidemia mista")}}

        else{if(LDLc >= 160 && TG >=  175) {warning("Hiperlipidemia mista")}}
        
        #Hipercolesterolemia isolada
        if(LDLc >= 160) {Hmista = FALSE
    
        if(jejum == TRUE && TG >= 150) {Hmista = TRUE}
    
        if(jejum == FALSE && TG >= 175) {Hmista = TRUE}
    
        if(!Hmista) {warning("Hipercolesterolemia isolada.")}}
  
# Retorno LDL-c
return(LDLc)}
