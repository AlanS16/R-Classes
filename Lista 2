#Exercício 1
#Leitura dos dados
urlfile="https://raw.githubusercontent.com/edsonzmartinez/cursoR/main/Dados_jogadores.csv"
jog <- read.csv2(urlfile)

#a
data.frame("Média" = mean(jog$idade),
           "dp" = sd(jog$idade),
           "mediana" = median(jog$idade),
           "amplitude" = (max(jog$idade)-min(jog$idade)),
           "IQR" = IQR(jog$idade))

#b
medidas_altura = function() data.frame("Média" = mean(jog$altura[jog$idade>25], na.rm = TRUE),
                                       "dp" = sd(jog$altura[jog$idade>25], na.rm = TRUE))
medidas_alura()

#c
tapply(jog$altura, jog$posicao, function(v) c(
        "Média" = mean(v, na.rm = TRUE),
        "dp" = sd(v, na.rm = TRUE),
        "Mediana" = median(v, na.rm = TRUE)))

#d
Correlacao = function() if(cor.test(jog$idade, jog$altura, method = "pearson")$p.value > 0.05) "Não há correlação entre idade e altura" else "Há correlação entre idade e altura"
Correlacao()

#e
data.frame("Frequência absoluta" = table(jog$posicao),
           "Frequência relativa" = prop.table(table(jog$posicao)))

#f
idades = cut(jog$idade, breaks = c(22, 24, 26, 28, 30, 32, 34),
                        labels = c("22-24", "24-26", "26-28", "28-30", "30-32", "32-40"))
                        
tabela_idade = table(idades)
print(tabela_idade)

